---
import LessonLayout from '../../layouts/LessonLayout.astro';
const base = import.meta.env.BASE_URL;
const topics = [
  { id: 'models', weeks: 'Weeks 1–2', title: 'Models and equilibrium', description: 'Choose supports, identify restraints and balance the external actions.', links: [
    ['Beam basics · supports and reactions', 'learn/beam-basics/'],
    ['Practise equilibrium', '#practice']
  ] },
  { id: 'trusses', weeks: 'Weeks 3–4', title: 'Planar trusses', description: 'Relate the support arrangement and member layout to stability and axial forces.', links: [
    ['Method of joints', '?exercise=ideal-planar-truss'],
    ['Method of sections', '?exercise=week04-truss-sections']
  ] },
  { id: 'beams', weeks: 'Weeks 4–5', title: 'Beams', description: 'Cut a beam and relate the loads on the free body to shear force and bending moment.', links: [
    ['Beam basics · internal forces and diagrams', 'learn/beam-basics/#sections'],
    ['Simple beams', '?exercise=simple-beams']
  ] },
  { id: 'frames', weeks: 'Weeks 6–7', title: 'Frames', description: 'Inspect member forces and locate the greatest bending-moment magnitude in a portal frame.', links: [
    ['Portal frame · maximum |M|', '?exercise=portal-absolute-moment#sandbox'],
    ['Checked frame workspace', 'portal-checker/']
  ] },
  { id: 'deflections', weeks: 'Weeks 8–13', title: 'Deflections and energy methods', description: 'Explore the deflected shape, rotation and displacement of a beam.', links: [
    ['Explore a beam in the sandbox', '?lesson=beam-basics#sandbox']
  ] }
];
---
<LessonLayout title="Structural analysis course" description="CV2011 lessons and practice by structural-analysis topic.">
  <div class="course-home">
    <header class="course-intro"><p class="eyebrow">CV2011 · Structural Analysis 1</p><h1>Course</h1></header>
    <section class="course-map" aria-label="Course topics"><ol>{topics.map(topic =>
      <li id={topic.id}><span class="eyebrow">{topic.weeks}</span><div><h2>{topic.title}</h2><p>{topic.description}</p>
        <div class="lesson-links">{topic.links.map(([name,path]) => <a href={base + path}>{name}</a>)}</div>
      </div></li>)}</ol></section>
  </div>
</LessonLayout>
