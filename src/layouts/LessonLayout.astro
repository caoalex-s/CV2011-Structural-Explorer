---
import LearningSession from '../components/LearningSession.astro';
import '../styles/learn.css';
interface Props { title: string; description: string; activity?: boolean; }
const { title, description, activity = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · CV2011 Structural Explorer</title>
    <link rel="stylesheet" href={`${base}theme.css`} />
    <link rel="stylesheet" href={`${base}vendor/katex/katex.min.css`} />
  </head>
  <body data-base={base}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="learn-header">
      <a class="learn-brand" href={`${base}learn/`}><svg viewBox="0 0 40 40" aria-hidden="true"><path d="M7 28V12h26v16M7 12l13 16 13-16M3 32h8m18 0h8" /></svg><span>Structural Explorer<small>CV2011 · Learn</small></span></a>
      <nav aria-label="Main"><a href={`${base}learn/`} aria-current="page">Learn</a><a href={`${base}#sandbox`}>Sandbox</a><a href={`${base}#practice`}>Solve a problem</a></nav>
      {activity && <button id="settings-button" class="quiet">Session</button>}
    </header>
    <main id="main"><slot /></main>
    <footer class="learn-footer"><span>CV2011 · Structural Analysis 1</span><span>Alex Sixie Cao · NTU Singapore</span></footer>
    {activity && <LearningSession />}
  </body>
</html>
